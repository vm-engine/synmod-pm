includes:
    - ../../vendor/larastan/larastan/extension.neon

parameters:
    level: 7
    paths:
        - src
    tmpDir: build/phpstan
    ignoreErrors:
        # Used only by Livewire single-file components under resources/views, which PHPStan does not analyse
        -
            identifier: trait.unused
            path: src/Form/Concerns/EditsProposalSections.php
