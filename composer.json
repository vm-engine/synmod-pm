{
    "name": "vm-engine/synmod-pm",
    "version": "0.2.1",
    "description": "Pm module for Laravel Synapse",
    "keywords": ["laravel", "synapse", "module", "livewire"],
    "type": "synapse-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Achmad Ardiansyah",
            "email": "theadods@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0",
        "livewire/livewire": "^3.0",
        "vm-engine/synapse": "@dev"
    },
    "require-dev": {
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "VmEngine\\Pm\\": "src/",
            "VmEngine\\Pm\\Seeders\\": "database/seeders/",
            "VmEngine\\Pm\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VmEngine\\Pm\\PmServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../synapse"
        }
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
