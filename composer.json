{
    "name": "vm-engine/synmod-pm",
    "version": "0.8.0",
    "description": "Project Management module for Laravel Synapse",
    "keywords": [
        "laravel",
        "synapse",
        "module",
        "livewire"
    ],
    "type": "synapse-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Achmad Ardiansyah",
            "email": "theadods@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "vm-engine/synapse": "^2.2",
        "vm-engine/synapps-auth": "^2.0",
        "barryvdh/laravel-dompdf": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "VmEngine\\Pm\\": "src/",
            "VmEngine\\Pm\\Factories\\": "database/factories/",
            "VmEngine\\Pm\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VmEngine\\Pm\\PmServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../synapps-auth",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../synapse",
            "options": {
                "symlink": true
            }
        }
    ]
}
